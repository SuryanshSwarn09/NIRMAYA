# ==============================================================================
# NIRMAYA Healthcare Platform - Edge Node Appliance Configuration Blueprint
#
# Designed for rural PHCs, sub-centers, and solo practitioners (< 512MB RAM)
# ==============================================================================

NIRMAYA_NODE_ID=EDGE-PHC-BIHAR-042
FACILITY_NAME=Primary Health Center Bikramganj
FACILITY_TIER=TIER_3_RURAL_CLINIC

# Embedded encrypted local SQLite database path
SQLITE_DB_PATH=/data/nirmaya_edge.db

# Central cloud uplink endpoint
UPLINK_URL=https://api.nirmaya.health
AUTO_SYNC_INTERVAL_SECONDS=300
MAX_OFFLINE_RETENTION_DAYS=90

# Local secret key
SECRET_KEY=replace_with_edge_node_secret_key_minimum_32_characters
