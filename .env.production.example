# ==============================================================================
# NIRMAYA Healthcare Platform - Production Environment Configuration Blueprint
#
# IMPORTANT:
# - Copy this template to .env before starting containers: `cp .env.production.example .env`
# - Never commit your production .env file with active credentials into git.
# - Generate high-entropy secrets using `openssl rand -hex 32`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Ingress Settings
# ------------------------------------------------------------------------------
DOMAIN_NAME=nirmaya.health
API_DOMAIN_NAME=api.nirmaya.health
ACME_EMAIL=admin@nirmaya.health

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=nirmaya
POSTGRES_USER=nirmaya_user
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_high_entropy_postgres_password_min_32_chars

# ------------------------------------------------------------------------------
# 3. Redis 7 Cache & WebSocket Pub/Sub Configuration
# ------------------------------------------------------------------------------
# Generate: openssl rand -hex 24
REDIS_PASSWORD=replace_with_high_entropy_redis_password_min_32_chars

# ------------------------------------------------------------------------------
# 4. Security & Cryptographic Tokens
# ------------------------------------------------------------------------------
# Generate: openssl rand -hex 32
SECRET_KEY=replace_with_cryptographically_secure_jwt_secret_key_minimum_64_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 5. Application Worker Concurrency & CORS
# ------------------------------------------------------------------------------
ENVIRONMENT=production
WEB_CONCURRENCY=4
CORS_ORIGINS=https://nirmaya.health,https://api.nirmaya.health

# ------------------------------------------------------------------------------
# 6. Frontend Next.js Public Endpoints
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://nirmaya.health/api/v1
NEXT_PUBLIC_WS_URL=wss://nirmaya.health/ws
