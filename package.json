{
  "name": "nirmaya",
  "version": "0.1.0",
  "description": "Networked Interoperable Records Medical Assets & Your Archives",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./scripts/run-dev.ps1",
    "dev:bash": "bash ./scripts/run-dev.sh",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "cd backend && python -m pytest -v",
    "test": "npm --prefix frontend run build && cd backend && python -m pytest",
    "doctor": "python scripts/doctor.py"
  },
  "homepage": "https://suryanshs-projects.gitbook.io/nirmaya-docs",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuryanshSwarn09/NIRMAYA.git"
  },
  "keywords": [
    "healthcare",
    "interoperability",
    "hl7-fhir",
    "abdm",
    "abha",
    "emr",
    "health-vault",
    "fastapi",
    "nextjs"
  ],
  "author": "Suryansh Swarn",
  "license": "MIT"
}
